# ---------------------------------------------------------------- core
# Signing key for the session cookie. REQUIRED in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUNT_SECRET=

# Where team + user data is stored. Defaults to ./data/hunt.json
# HUNT_DATA_FILE=/var/lib/bep-hunt/hunt.json

# --------------------------------------------------------------- timing
# When the locks open. ISO 8601 — ALWAYS include the offset (+05:30 for IST).
# Leave blank and the hunt is open immediately (useful while building).
HUNT_OPENS_AT=2026-09-12T18:00:00+05:30

# Optional hard stop. Blank means it never closes.
# HUNT_CLOSES_AT=2026-09-14T23:59:00+05:30

# ---------------------------------------------------------- google auth
# From https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID, type "Web application"
#   2. Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback
#      (http://localhost:3000/api/auth/callback for local work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if the app sits behind a proxy that rewrites the origin.
# HUNT_OAUTH_REDIRECT=https://hunt.example.com/api/auth/callback

# Comma-separated email domains allowed to register.
# Defaults to the four BITS campus domains. Use "*" to allow any account.
# HUNT_ALLOWED_DOMAINS=pilani.bits-pilani.ac.in

# ---------------------------------------------------------------- teams
# HUNT_MAX_TEAM_SIZE=4

# ------------------------------------------------------------ dev only
# Skips Google entirely so the flow can be tested without credentials.
# Ignored in production builds — it cannot be switched on for the event.
# HUNT_AUTH_MOCK=1

# ------------------------------------------------------------- database
# Required on Vercel (its filesystem is read-only and each request may hit
# a different instance). Any Postgres works — Neon, Supabase, Render
# Postgres, Vercel Postgres. Hosted providers need ?sslmode=require.
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
#
# Leave it blank locally and the app uses ./data/hunt.json instead.
# Verify a URL with:  npm run db:check
DATABASE_URL=
